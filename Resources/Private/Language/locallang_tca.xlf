    <file source-language="en" datatype="plaintext" original="messages" date="2026-03-16T00:00:00Z" product-name="aim">
        <header/>
        <body>
            <trans-unit id="tx_aim_configuration.title" resname="tx_aim_configuration.title">
                <source>AI Provider Configuration</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.palette.config.label" resname="tx_aim_configuration.palette.config.label">
                <source>Configuration</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.palette.cost.label" resname="tx_aim_configuration.palette.cost.label">
                <source>Cost Tracking</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.palette.tokenCosts.label" resname="tx_aim_configuration.palette.tokenCosts.label">
                <source>Token Costs</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.palette.governance.label" resname="tx_aim_configuration.palette.governance.label">
                <source>Access Control and Privacy</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.ai_provider.label" resname="tx_aim_configuration.columns.ai_provider.label">
                <source>AI Provider</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.ai_provider.description" resname="tx_aim_configuration.columns.ai_provider.description">
                <source>The installed provider bridge this configuration talks to. If the list is empty, no bridge is installed yet; see the Providers module for what to install.</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.title.label" resname="tx_aim_configuration.columns.title.label">
                <source>Title</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.description.label" resname="tx_aim_configuration.columns.description.label">
                <source>Description</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.default.label" resname="tx_aim_configuration.columns.default.label">
                <source>Default</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.default.description" resname="tx_aim_configuration.columns.default.description">
                <source>The configuration used when a caller asks for a capability without naming a provider. Only one is needed; if several are flagged, the one with the lowest uid wins.</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.endpoint.label" resname="tx_aim_configuration.columns.endpoint.label">
                <source>Endpoint URL</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.endpoint.description" resname="tx_aim_configuration.columns.endpoint.description">
                <source>
Base URL of a self-hosted or proxied provider (Ollama, LM Studio, an OpenAI-compatible gateway).
Leave empty for hosted providers. This field is stored as plain text, so use the API Key field for the credentials.
For a host that uses basic auth, enter https://user:password@host. Saving keeps https://user@host here and moves the
password into the encrypted API Key field. The user name has to stay in the URL, since that is what marks the credential
as belonging in the URL rather than in a bearer token.
Only the password half is moved. A provider whose scheme makes the key itself the user name, with an empty password
(https://key:@host), is not supported here: that key would stay in this plain-text field, would appear in the record
history, and would be shown in the Providers list. Do not enter one.
				</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.api_key.label" resname="tx_aim_configuration.columns.api_key.label">
                <source>API Key</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.api_key.description" resname="tx_aim_configuration.columns.api_key.description">
                <source>
The provider credential. Always stored encrypted. A self-hosted provider that needs no credential (Ollama, LM Studio)
only needs the Endpoint URL. An already-saved key is never shown again; leave this empty to keep it unchanged, or enter
a new value to replace it. For a host that uses basic auth, put the user name in the endpoint URL (https://user@host)
and the password here: without a user name in the URL this value is sent as a bearer token instead.
				</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.api_key.clear" resname="tx_aim_configuration.columns.api_key.clear">
                <source>Remove the stored API key on save</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.api_key.clear.armed" resname="tx_aim_configuration.columns.api_key.clear.armed">
                <source>Keep the stored API key after all</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.api_key.clear.pending" resname="tx_aim_configuration.columns.api_key.clear.pending">
                <source>The stored API key will be removed on save. Click the button again to keep it.</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.api_key.clear.placeholder" resname="tx_aim_configuration.columns.api_key.clear.placeholder">
                <source>Will be removed on save</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.api_key.placeholder.configured" resname="tx_aim_configuration.columns.api_key.placeholder.configured">
                <source>A key is configured; leave empty to keep it</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.model.label" resname="tx_aim_configuration.columns.model.label">
                <source>Model</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.model.description" resname="tx_aim_configuration.columns.model.description">
                <source>Which model this configuration sends to. It can stay empty while you are setting the provider up, but a configuration without a model is skipped as if it were disabled.</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.total_cost.label" resname="tx_aim_configuration.columns.total_cost.label">
                <source>Total Cost</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.total_cost.description" resname="tx_aim_configuration.columns.total_cost.description">
                <source>Accumulated cost of every logged request made through this configuration. Written by the extension and never reset.</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.cost_currency.label" resname="tx_aim_configuration.columns.cost_currency.label">
                <source>Currency</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.be_groups.label" resname="tx_aim_configuration.columns.be_groups.label">
                <source>Restrict to user groups</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.be_groups.description" resname="tx_aim_configuration.columns.be_groups.description">
                <source>Backend groups whose members may use this configuration. Empty means no restriction, so everyone can use it. A command-line run has no backend user and is not group-restricted at all.</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.privacy_level.label" resname="tx_aim_configuration.columns.privacy_level.label">
                <source>Privacy level</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.privacy_level.standard" resname="tx_aim_configuration.columns.privacy_level.standard">
                <source>Standard (full logging)</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.privacy_level.reduced" resname="tx_aim_configuration.columns.privacy_level.reduced">
                <source>Reduced (no prompt/response content)</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.privacy_level.none" resname="tx_aim_configuration.columns.privacy_level.none">
                <source>None (no logging at all)</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.accepts_rerouted_requests.label" resname="tx_aim_configuration.columns.accepts_rerouted_requests.label">
                <source>Accept rerouted requests</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.accepts_rerouted_requests.description" resname="tx_aim_configuration.columns.accepts_rerouted_requests.description">
                <source>
Whether other configurations may hand their requests to this one, as a fallback when they fail, or when the smart router
picks this model as a cheaper alternative. Turn this off for a model reserved for particular content, so general traffic
never lands on it. This is the opposite direction to "Allow rerouting", which controls whether this configuration's own
requests may go elsewhere.
				</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.rerouting_allowed.label" resname="tx_aim_configuration.columns.rerouting_allowed.label">
                <source>Allow smart rerouting</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.rerouting_allowed.description" resname="tx_aim_configuration.columns.rerouting_allowed.description">
                <source>
When disabled, this configuration's requests never go anywhere else: the smart router will not downgrade them to a cheaper
model, and a failed request is not retried against another provider. Use this for configurations handling sensitive data
(e.g. a local model for HR), so that data stays on the model it was designated for. Whether other configurations may
reroute TO this one is controlled separately, by "Accept rerouted requests".
				</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.auto_model_switch.label" resname="tx_aim_configuration.columns.auto_model_switch.label">
                <source>Allow auto model switch</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.auto_model_switch.description" resname="tx_aim_configuration.columns.auto_model_switch.description">
                <source>When enabled, AiM can automatically switch to a specialized model (e.g. an embedding model) using this configuration's API key when the configured model does not support the requested capability.</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.max_tokens.label" resname="tx_aim_configuration.columns.max_tokens.label">
                <source>Max Tokens</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.max_tokens.description" resname="tx_aim_configuration.columns.max_tokens.description">
                <source>Upper limit on the length of every response from this configuration, in tokens. The default of 150 is roughly two sentences, which is deliberately small: raise it for anything longer, and raise it well above the answer length you expect for a reasoning model, since its internal reasoning counts against the same limit.</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.input_token_cost.label" resname="tx_aim_configuration.columns.input_token_cost.label">
                <source>Input Token Cost (per 1M)</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.output_token_cost.label" resname="tx_aim_configuration.columns.output_token_cost.label">
                <source>Output Token Cost (per 1M)</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.tab.grading" resname="tx_aim_configuration.tab.grading">
                <source>LLM Grading</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.palette.grading.label" resname="tx_aim_configuration.palette.grading.label">
                <source>Response Quality Grading</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.grading_enabled.label" resname="tx_aim_configuration.columns.grading_enabled.label">
                <source>Enable LLM grading</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.grading_enabled.description" resname="tx_aim_configuration.columns.grading_enabled.description">
                <source>When enabled, successful responses from this configuration are scored by a second LLM (the judge) after the response has been delivered. The score, label, and reason are stored on the request log row. Grading only runs when the effective privacy level is "standard". Reduced or none disables it.</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.judge_configuration_uid.label" resname="tx_aim_configuration.columns.judge_configuration_uid.label">
                <source>Judge configuration</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.judge_configuration_uid.description" resname="tx_aim_configuration.columns.judge_configuration_uid.description">
                <source>The AiM configuration used to score responses. Should be a separate, cheaper or specialized configuration that supports the conversation capability. Cannot be this configuration itself.</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.grading_rubric.label" resname="tx_aim_configuration.columns.grading_rubric.label">
                <source>Grading rubric (judge system prompt)</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.grading_rubric.description" resname="tx_aim_configuration.columns.grading_rubric.description">
                <source>System prompt for the judge. Describe what to evaluate (e.g. factual accuracy, relevance, tone). The judge is instructed automatically to respond with JSON containing score (0.0–1.0), label (poor|fair|good|excellent), and reason. No need to mention the output format here.</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.grading_rubric.placeholder" resname="tx_aim_configuration.columns.grading_rubric.placeholder">
                <source>Evaluate the response for factual accuracy and relevance to the user's prompt.</source>
            </trans-unit>
            <trans-unit id="pages.tab_ai" resname="pages.tab_ai">
                <source>AI Tone of Voice</source>
            </trans-unit>
            <trans-unit id="pages.tx_aim_disable_inherited_fragments.label" resname="pages.tx_aim_disable_inherited_fragments.label">
                <source>Disable inherited prompt fragments</source>
            </trans-unit>
            <trans-unit id="pages.tx_aim_disable_inherited_fragments.description" resname="pages.tx_aim_disable_inherited_fragments.description">
                <source>When enabled, this page ignores prompt fragments inherited from ancestor pages (even ones with "Inherit to subpages" checked); only this page's own fragments apply. Affects this page only, not its subpages, which keep inheriting from the original ancestors normally. Does not affect fragments set via TSconfig.</source>
            </trans-unit>
            <trans-unit id="pages.tx_aim_prompt_fragments.label" resname="pages.tx_aim_prompt_fragments.label">
                <source>Tone of Voice / System Prompt Fragments</source>
            </trans-unit>
            <trans-unit id="pages.tx_aim_prompt_fragments.description" resname="pages.tx_aim_prompt_fragments.description">
                <source>Assigns reusable prompt fragments (e.g. formality, brand voice, forbidden phrasing, image watermark policy) to this page. Pick an existing fragment from the library or create a new one. Each fragment applies only to the capability set in its own Scope. An assignment with "Inherit to subpages" enabled also applies to every page below this one, until a descendant page adds its own assignments of the same scope (which supplement, not replace, inherited ones). Does not apply to image alt-text generation, which uses the global default instead.</source>
            </trans-unit>
            <trans-unit id="tx_aim_prompt_fragment.title" resname="tx_aim_prompt_fragment.title">
                <source>AI Prompt Fragment</source>
            </trans-unit>
            <trans-unit id="tx_aim_prompt_fragment.columns.title.label" resname="tx_aim_prompt_fragment.columns.title.label">
                <source>Title</source>
            </trans-unit>
            <trans-unit id="tx_aim_prompt_fragment.columns.title.description" resname="tx_aim_prompt_fragment.columns.title.description">
                <source>Internal label only, never sent to the AI.</source>
            </trans-unit>
            <trans-unit id="tx_aim_prompt_fragment.columns.prompt.label" resname="tx_aim_prompt_fragment.columns.prompt.label">
                <source>Prompt</source>
            </trans-unit>
            <trans-unit id="tx_aim_prompt_fragment.columns.prompt.description" resname="tx_aim_prompt_fragment.columns.prompt.description">
                <source>Sent with every matching AI call on every page this fragment is assigned to; keep it concise to limit the ongoing token cost.</source>
            </trans-unit>
            <trans-unit id="tx_aim_prompt_fragment.columns.examples.label" resname="tx_aim_prompt_fragment.columns.examples.label">
                <source>Examples</source>
            </trans-unit>
            <trans-unit id="tx_aim_prompt_fragment.columns.examples.description" resname="tx_aim_prompt_fragment.columns.examples.description">
                <source>Optional. One "Q: ..." / "A: ..." pair per example, blank line between examples; steers the AI more reliably than the prompt alone. Keep it to a few short ones; it adds to every call's token cost.</source>
            </trans-unit>
            <trans-unit id="tx_aim_prompt_fragment.columns.scope.label" resname="tx_aim_prompt_fragment.columns.scope.label">
                <source>Capability</source>
            </trans-unit>
            <trans-unit id="tx_aim_prompt_fragment.columns.scope.description" resname="tx_aim_prompt_fragment.columns.scope.description">
                <source>All are checked by default; uncheck the capabilities this fragment should not apply to.</source>
            </trans-unit>
            <trans-unit id="tx_aim_prompt_fragment.columns.scope.all" resname="tx_aim_prompt_fragment.columns.scope.all">
                <source>All capabilities</source>
            </trans-unit>
            <trans-unit id="tx_aim_prompt_fragment.columns.scope.text" resname="tx_aim_prompt_fragment.columns.scope.text">
                <source>Text Generation</source>
            </trans-unit>
            <trans-unit id="tx_aim_prompt_fragment.columns.scope.vision" resname="tx_aim_prompt_fragment.columns.scope.vision">
                <source>Vision</source>
            </trans-unit>
            <trans-unit id="tx_aim_prompt_fragment.columns.scope.translation" resname="tx_aim_prompt_fragment.columns.scope.translation">
                <source>Translation</source>
            </trans-unit>
            <trans-unit id="tx_aim_prompt_fragment.columns.scope.conversation" resname="tx_aim_prompt_fragment.columns.scope.conversation">
                <source>Conversation</source>
            </trans-unit>
            <trans-unit id="tx_aim_prompt_fragment.columns.scope.toolCalling" resname="tx_aim_prompt_fragment.columns.scope.toolCalling">
                <source>Tool Calling</source>
            </trans-unit>
            <trans-unit id="tx_aim_prompt_fragment.columns.scope.imageGeneration" resname="tx_aim_prompt_fragment.columns.scope.imageGeneration">
                <source>Image Generation</source>
            </trans-unit>
            <trans-unit id="tx_aim_page_prompt_fragment.title" resname="tx_aim_page_prompt_fragment.title">
                <source>Prompt Fragment Assignment</source>
            </trans-unit>
            <trans-unit id="tx_aim_page_prompt_fragment.columns.fragment.label" resname="tx_aim_page_prompt_fragment.columns.fragment.label">
                <source>Fragment</source>
            </trans-unit>
            <trans-unit id="tx_aim_page_prompt_fragment.columns.fragment.description" resname="tx_aim_page_prompt_fragment.columns.fragment.description">
                <source>Start typing to search the fragment library (only fragments stored globally or within this page's own site are suggested), use the browse icon to see every fragment in the installation, or use the "+" button to create a new one. On a brand-new assignment, pick and save an existing fragment first - "+" only becomes available once this assignment itself has been saved.</source>
            </trans-unit>
            <trans-unit id="tx_aim_page_prompt_fragment.columns.fragment.addRecord" resname="tx_aim_page_prompt_fragment.columns.fragment.addRecord">
                <source>Create a new prompt fragment</source>
            </trans-unit>
            <trans-unit id="tx_aim_page_prompt_fragment.columns.inherit_to_subpages.label" resname="tx_aim_page_prompt_fragment.columns.inherit_to_subpages.label">
                <source>Inherit to subpages</source>
            </trans-unit>
            <trans-unit id="tx_aim_page_prompt_fragment.columns.inherit_to_subpages.description" resname="tx_aim_page_prompt_fragment.columns.inherit_to_subpages.description">
                <source>When enabled (default), this assignment also applies to every page below this one in the tree.</source>
            </trans-unit>
            <trans-unit id="tx_aim_page_prompt_fragment.columns.hidden.label" resname="tx_aim_page_prompt_fragment.columns.hidden.label">
                <source>Active</source>
            </trans-unit>
            <trans-unit id="tx_aim_page_prompt_fragment.columns.hidden.description" resname="tx_aim_page_prompt_fragment.columns.hidden.description">
                <source>Only active assignments are composed into system prompts. Automatically generated assignments start out inactive, so their content needs review before it reaches a model.</source>
            </trans-unit>
            <trans-unit id="tx_aim_page_prompt_fragment.noFragmentSelected" resname="tx_aim_page_prompt_fragment.noFragmentSelected">
                <source>(no fragment selected)</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.system_prompt_addition.label" resname="tx_aim_configuration.columns.system_prompt_addition.label">
                <source>Provider-specific Prompt Addendum</source>
            </trans-unit>
            <trans-unit id="tx_aim_configuration.columns.system_prompt_addition.description" resname="tx_aim_configuration.columns.system_prompt_addition.description">
                <source>Optional extra instructions appended only when this provider configuration is used, after the page/site system prompt fragments (e.g. a model-specific quirk or formatting instruction).</source>
            </trans-unit>
            <trans-unit id="permissions.header" resname="permissions.header">
                <source>AI Management</source>
            </trans-unit>
            <trans-unit id="permissions.capability.text" resname="permissions.capability.text">
                <source>Text Generation</source>
            </trans-unit>
            <trans-unit id="permissions.capability.vision" resname="permissions.capability.vision">
                <source>Vision</source>
            </trans-unit>
            <trans-unit id="permissions.capability.translation" resname="permissions.capability.translation">
                <source>Translation</source>
            </trans-unit>
            <trans-unit id="permissions.capability.conversation" resname="permissions.capability.conversation">
                <source>Conversation</source>
            </trans-unit>
            <trans-unit id="permissions.capability.embedding" resname="permissions.capability.embedding">
                <source>Embedding</source>
            </trans-unit>
            <trans-unit id="permissions.capability.toolcalling" resname="permissions.capability.toolcalling">
                <source>Tool Calling</source>
            </trans-unit>
        </body>
