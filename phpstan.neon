# composer.json sets vendor-dir to .Build/vendor, so these are not the
# default paths a generated config would carry.
includes:
    - .Build/vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - .Build/vendor/saschaegerer/phpstan-typo3/extension.neon
    - phpstan-baseline.neon

parameters:
  level: 5

  treatPhpDocTypesAsCertain: false

  # This extension's own code, not the whole working directory: that pulled
  # .Build/vendor, i.e. the entire TYPO3 core, into the analysis.
  paths:
    - %currentWorkingDirectory%/Classes/
    - %currentWorkingDirectory%/Configuration/
    - %currentWorkingDirectory%/Tests/
    - %currentWorkingDirectory%/ext_localconf.php
    - %currentWorkingDirectory%/ext_emconf.php

  excludePaths:
    analyseAndScan:
      - */node_modules/*
      - .Build/*
      - public/*

  ignoreErrors:
    -
      '#Variable \$_EXTKEY might not be defined#'
    -
      identifier: method.internal
    -
      identifier: method.internalClass
    -
      identifier: new.internalClass
    -
      identifier: staticMethod.internal
    -
      identifier: property.internal
    -
      identifier: classConstant.internalClass
